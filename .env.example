# Environment Configuration for Tax Savings MVP

# Application environment
ENV=dev
PORT=8000

# Database configuration
# SQLite (default): sqlite:///./tax_savings.db
# PostgreSQL: postgresql://user:password@localhost/tax_savings_db
DATABASE_URL=sqlite:///./tax_savings.db

# Encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-key-here

# Debug SQL queries (set to "true" to enable)
SQL_ECHO=false
