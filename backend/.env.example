# Environment variables template
# Copy to .env and fill in your values
# DO NOT commit .env to git!

# Database Configuration
# Local development (SQLite):
# DATABASE_URL=sqlite:///./tax_savings.db

# Production (Supabase PostgreSQL):
# Get from: Supabase Dashboard → Settings → Database → Connection Pooler
# Use "Transaction" mode for Vercel serverless
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST/postgres?sslmode=require

# Stripe API Keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxx

# Application Environment
# Options: dev, staging, production
ENV=dev

# Optional: SQL Query Logging
# Set to true to see all SQL queries in logs
SQL_ECHO=false

# Optional: Debug Mode (development only)
DEBUG=false
